{
  "id": "student-admission",
  "title": "Student Admission",
  "description": "Please complete the following information to submit your application.",

  "progress": {
    "showOverall": true,
    "showSection": true
  },

  "navigation": {
    "previous": "Previous",
    "next": "Next",
    "save": "Save",
    "submit": "Submit"
  },

  "review": {
    "enabled": true,
    "title": "Review Your Application",
    "description": "Please review your information before submitting.",
    "editLabel": "Edit"
  },

  "sections": [
    {
      "id": "personal",
      "title": "Personal Information",
      "description": "Tell us about yourself.",

      "fields": [
        {
          "id": "firstName",
          "type": "text",
          "label": "First Name",
          "required": true,
          "validation": {
            "minLength": 2,
            "maxLength": 50,
            "pattern": "^[A-Za-zÀ-ÖØ-öø-ÿ' -]+$"
          },
          "messages": {
            "required": "First name is required.",
            "minLength": "First name must contain at least 2 characters.",
            "maxLength": "First name cannot exceed 50 characters.",
            "pattern": "First name can only contain letters."
          }
        },
        {
          "id": "lastName",
          "type": "text",
          "label": "Last Name",
          "placeholder": "Enter your last name",
          "required": true,
          "validation": {
            "minLength": 2,
            "maxLength": 50
          },
          "messages": {
            "required": "Last name is required.",
            "minLength": "Last name must be at least 2 characters.",
            "maxLength": "Last name cannot exceed 50 characters."
          }
        },
        {
          "id": "email",
          "type": "email",
          "label": "Email Address",
          "placeholder": "you@example.com",
          "required": true,
          "validation": {
            "email": true
          },
          "messages": {
            "required": "Email address is required.",
            "email": "Please enter a valid email address."
          }
        },
        {
          "id": "age",
          "type": "number",
          "label": "Age",
          "required": true,
          "validation": {
            "min": 16,
            "max": 100
          },
          "messages": {
            "required": "Age is required.",
            "min": "You must be at least 16 years old.",
            "max": "Please enter a valid age."
          }
        },
        {
          "id": "dateOfBirth",
          "type": "date",
          "label": "Date of Birth",
          "required": true,
          "validation": {
            "minAge": 16,
            "maxAge": 100
          },
          "messages": {
            "required": "Date of birth is required.",
            "invalidDate": "Please enter a valid date of birth.",
            "minAge": "You must be at least 16 years old.",
            "maxAge": "Please enter a valid date of birth."
          }
        },
        {
          "id": "appointmentDate",
          "type": "date",
          "label": "Appointment Date",
          "required": true,
          "validation": {
            "minDaysFromToday": 1,
            "maxDaysFromToday": 90
          },
          "messages": {
            "required": "Please select an appointment date.",
            "invalidDate": "Please enter a valid date.",
            "minDaysFromToday": "The appointment must be at least one day from today.",
            "maxDaysFromToday": "The appointment cannot be more than 90 days from today."
          }
        },
        {
          "id": "gender",
          "type": "radio",
          "label": "Gender",
          "required": true,

          "options": [
            {
              "value": "female",
              "label": "Female"
            },
            {
              "value": "male",
              "label": "Male"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],

          "messages": {
            "required": "Please select an option."
          }
        }
      ]
    },

    {
      "id": "contact",
      "title": "Contact Information",
      "description": "How can we contact you?",

      "fields": [
        {
          "id": "phone",
          "type": "tel",
          "label": "Phone Number",
          "placeholder": "Enter your phone number",
          "required": true
        },

        {
          "id": "country",
          "type": "select",
          "label": "Country",
          "required": true,

          "options": [
            {
              "value": "india",
              "label": "India"
            },
            {
              "value": "usa",
              "label": "United States"
            },
            {
              "value": "france",
              "label": "France"
            },
            {
              "value": "netherlands",
              "label": "Netherlands"
            }
          ],

          "messages": {
            "required": "Please select your country."
          }
        }
      ]
    },

    {
      "id": "address",
      "title": "Address",
      "description": "Where do you currently live?",

      "review": {
        "groups": [
          {
            "id": "address",
            "type": "address",
            "fields": ["addressLine1", "addressLine2", "city", "state", "postcode", "country"],

            "format": ["line1", "line2", "cityStatePostcode", "country"]
          }
        ]
      },

      "fields": [
        {
          "id": "addressLine1",
          "type": "text",
          "label": "Address Line 1",
          "required": true
        },

        {
          "id": "addressLine2",
          "type": "text",
          "label": "Address Line 2"
        },

        {
          "id": "city",
          "type": "text",
          "label": "City",
          "required": true
        },

        {
          "id": "state",
          "type": "text",
          "label": "State / Province"
        },

        {
          "id": "postcode",
          "type": "text",
          "label": "Postcode",
          "required": true
        }
      ]
    }
  ]
}
